# Copy this file to .env and paste your key in. .env is gitignored; this file
# is not, so it must never hold a real secret.
#
# Then, in the SAME terminal you run the agent from:
#     set -a && source .env && set +a
#
# That line is the fix for the most common error in this course:
# "OPENROUTER_API_KEY is not set". Editing .env is not enough - it has to be loaded into
# the shell that runs the process, every time you open a new terminal.

# ---- your key ----
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ---- the model ----
MODEL=anthropic/claude-sonnet-4.5
BASE_URL=https://openrouter.ai/api/v1

# How long to wait for one model call before giving up. Without this, one hung
# connection holds a worker open until the platform's own timeout.
MODEL_TIMEOUT_SECONDS=30

# A hard cap on trips round the agent loop, so a confused model cannot spin
# forever. Week 04 turns this into a real budget.
MAX_STEPS=6

# ---- Week 02: memory that survives a redeploy ----
# Unset  -> an in-process dict (fine for local dev; dies on every restart)
# Set    -> Redis, which lives outside the container and survives deploys
# REDIS_URL=redis://localhost:6379
SESSION_TTL=86400

# ---- Week 03: keep strangers out ----
# Comma-separated keys a caller must send as the x-api-key header.
# UNSET MEANS AUTH IS OFF. Fine locally; wide open in production.
API_KEYS=local-dev-key

# Requests allowed per key per rolling minute. One request here costs real
# money at the provider, so a loop in someone's script is a bill, not just load.
RATE_LIMIT_PER_MIN=20

# ---- the service ----
# Every container platform tells your service where to listen with $PORT.
PORT=7000

# ---- your agent's name ----
# Only used by the /whoami endpoint you add in Week 01. Pick anything - it is
# how you tell your container apart from a classmate's when you swap them.
AGENT_NAME=Support Agent
