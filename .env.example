# ---- model ----
# Your OpenRouter key, and the gateway it talks to.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
BASE_URL=https://openrouter.ai/api/v1

# Primary answers; fallback catches it if the primary fails (Week 06).
# These are two different vendors on purpose, so the Week 06 drill is real.
MODEL=anthropic/claude-sonnet-4.5
FALLBACK_MODEL=openai/gpt-4o-mini

# How long to wait for one model call before giving up (Week 06).
MODEL_TIMEOUT_SECONDS=30

# The agent's standing instructions. Leave unset to use the default in
# app/agent.py. In a real job this is the most-edited setting you have.
# SYSTEM_PROMPT=

# ---- service ----
PORT=7000

# ---- auth + rate limit (Week 03) ----
# Comma-separated keys allowed to call /chat. Empty = auth off (local dev).
API_KEYS=
RATE_LIMIT_PER_MIN=20

# ---- safety caps (Weeks 04, 07) ----
MAX_STEPS=6
MAX_TOKENS_PER_TURN=20000
MAX_INPUT_CHARS=4000

# Context is a budget too: how many past messages to keep in a session (Wk04).
MAX_HISTORY_MESSAGES=40

# What a TOOL hands back is untrusted input as well (Wk07).
MAX_TOOL_OUTPUT_CHARS=4000

# Rough $/1M tokens, so every trace carries what the turn cost (Wk05).
COST_PER_1M_INPUT=3.00
COST_PER_1M_OUTPUT=15.00

# ---- monitoring (Week 05) ----
# How many recent turns /metrics looks at, and when it says "degraded".
MONITOR_WINDOW=200
ALERT_ERROR_RATE=0.10
ALERT_P95_MS=15000
ALERT_FALLBACK_RATE=0.20
ALERT_AVG_STEPS=4.0
ALERT_TOOL_ERROR_RATE=0.05

# ---- OpenTelemetry (Week 05, optional) ----
# 1 = also publish each turn as OTel spans. Leave empty for the offline path.
# With no endpoint set, spans are printed so you can see their shape.
OTEL_ENABLED=
OTEL_SERVICE_NAME=ship-agent

# Where to send spans. Pick ONE:
#   (a) local Grafana + Tempo, via `make trace-ui`
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   (b) Google Cloud Trace once deployed - nothing to install or run
# OTEL_TARGET=gcp
# Leave both unset and spans are printed, which is enough to see their shape.

# ---- memory (Week 02) ----
# Set this to use Redis. Empty = in-process dict (fine for local dev).
REDIS_URL=
SESSION_TTL=86400

# ---- Week 06: retry before failing over ----
# A 429 or 503 is a blip, not an outage. Retry the SAME model first; switching
# providers silently changes the quality of every answer.
MAX_RETRIES=2
RETRY_BASE_SECONDS=0.5
RETRY_MAX_SECONDS=8

# ---- Week 07: the fetch tool (SSRF surface) ----
FETCH_TIMEOUT_SECONDS=5
FETCH_MAX_CHARS=20000

# ---- Week 08: the judge tier ----
# Which model grades answer quality. Needs OPENROUTER_API_KEY; skipped without it.
JUDGE_MODEL=anthropic/claude-sonnet-4.5
