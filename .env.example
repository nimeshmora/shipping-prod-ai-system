# Copy this file to .env and paste your key in. .env is gitignored; this file
# is not, so it must never hold a real secret.
#
# Then, in the SAME terminal you run the agent from:
#     set -a && source .env && set +a
#
# That line is the fix for the most common error in this course:
# "OPENROUTER_API_KEY is not set". Editing .env is not enough - it has to be loaded into
# the shell that runs the process, every time you open a new terminal.

# ---- your key ----
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ---- the model ----
MODEL=anthropic/claude-sonnet-4.5
BASE_URL=https://openrouter.ai/api/v1

# How long to wait for one model call before giving up. Without this, one hung
# connection holds a worker open until the platform's own timeout.
MODEL_TIMEOUT_SECONDS=30

# A hard cap on trips round the agent loop, so a confused model cannot spin
# forever. Week 04 turns this into a real budget.
MAX_STEPS=6

# ---- Week 02: memory that survives a redeploy ----
# Unset  -> an in-process dict (fine for local dev; dies on every restart)
# Set    -> Redis, which lives outside the container and survives deploys
# REDIS_URL=redis://localhost:6379
SESSION_TTL=86400

# ---- Week 03: keep strangers out ----
# Comma-separated keys a caller must send as the x-api-key header.
# UNSET MEANS AUTH IS OFF. Fine locally; wide open in production.
API_KEYS=local-dev-key

# Requests allowed per key per rolling minute. One request here costs real
# money at the provider, so a loop in someone's script is a bill, not just load.
RATE_LIMIT_PER_MIN=20

# ---- Week 04: what one turn is allowed to cost ----
# Trips round the agent loop. Catches a model that is looping or confused.
MAX_STEPS=6
# Tokens sent+received in one turn. Catches ONE enormous call, which a step
# limit cannot see. You want both: 6 colossal calls pass a step limit, and
# 100 tiny ones pass a token limit.
MAX_TOKENS_PER_TURN=20000
# Messages kept per session. Every turn re-sends the WHOLE history, so without
# this a long conversation grows the prompt until the model refuses it - and
# the per-turn token cap never sees it coming, because it resets each turn.
MAX_HISTORY_MESSAGES=40

# ---- Week 06: surviving a wobbly provider ----
# A 429 or 503 is a blip, not an outage. Retry the SAME model first; switching
# providers silently changes the quality of every answer, and nothing alerts
# because the turn still succeeds.
MAX_RETRIES=2
RETRY_BASE_SECONDS=0.5
RETRY_MAX_SECONDS=8
FALLBACK_MODEL=openai/gpt-4o-mini
ALERT_FALLBACK_RATE=0.20

# ---- Week 05: seeing inside a turn ----
# Rough dollars per 1M tokens, used to price every turn. Output costs 3-5x
# input, which is why they are separate: a blended rate badly overstates an
# input-heavy agent, and most agents are input-heavy.
COST_PER_1M_INPUT=3.00
COST_PER_1M_OUTPUT=15.00

# How many recent turns /metrics reasons over.
MONITOR_WINDOW=200

# Crossing one of these is not an outage, it is a "go look now".
ALERT_ERROR_RATE=0.10
ALERT_P95_MS=15000
ALERT_AVG_STEPS=4.0
ALERT_TOOL_ERROR_RATE=0.05

# OpenTelemetry: the same trace, in the shape the industry speaks.
# Off by default. Set OTEL_ENABLED=1 plus either an OTLP endpoint (Tempo,
# Jaeger, Honeycomb, Datadog) or OTEL_TARGET=gcp for Google Cloud Trace.
# OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- the service ----
# Every container platform tells your service where to listen with $PORT.
PORT=7000
