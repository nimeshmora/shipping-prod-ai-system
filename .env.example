# ---- model ----
# Your KodeKloud cohort key, and the gateway it talks to.
KODEKEY=sk-your-kodekey-here
BASE_URL=https://api.ai.kodekloud.com/v1

# Primary answers; fallback catches it if the primary fails (Week 06).
# These are two different vendors on purpose, so the Week 06 drill is real.
MODEL=claude-sonnet-5
FALLBACK_MODEL=gpt-oss-120b

# How long to wait for one model call before giving up (Week 06).
MODEL_TIMEOUT_SECONDS=30

# The agent's standing instructions. Leave unset to use the default in
# app/agent.py. In a real job this is the most-edited setting you have.
# SYSTEM_PROMPT=

# ---- service ----
PORT=8080

# ---- auth + rate limit (Week 03) ----
# Comma-separated keys allowed to call /chat. Empty = auth off (local dev).
API_KEYS=
RATE_LIMIT_PER_MIN=20

# ---- safety caps (Weeks 04, 07) ----
MAX_STEPS=6
MAX_TOKENS_PER_TURN=20000
MAX_INPUT_CHARS=4000

# Context is a budget too: how many past messages to keep in a session (Wk04).
MAX_HISTORY_MESSAGES=40

# What a TOOL hands back is untrusted input as well (Wk07).
MAX_TOOL_OUTPUT_CHARS=4000

# Rough $/1M tokens, so every trace carries what the turn cost (Wk05).
COST_PER_1M_INPUT=3.00
COST_PER_1M_OUTPUT=15.00

# ---- monitoring (Week 05) ----
# How many recent turns /metrics looks at, and when it says "degraded".
MONITOR_WINDOW=200
ALERT_ERROR_RATE=0.10
ALERT_P95_MS=15000
ALERT_FALLBACK_RATE=0.20
ALERT_AVG_STEPS=4.0
ALERT_TOOL_ERROR_RATE=0.05

# ---- memory (Week 02) ----
# Set this to use Redis. Empty = in-process dict (fine for local dev).
REDIS_URL=
SESSION_TTL=86400
