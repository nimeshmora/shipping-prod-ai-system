# Keep the image small, and keep secrets out of it.
#
# Without this file you copy .venv/, .git/ and every __pycache__ into the
# image - and, worse, .env. Never bake a secret into an image layer: layers
# are cached, shared between builds, and pushed to registries.
.venv/
venv/
.git/
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# secrets
.env
.env.local
*.key
*-credentials.json
service-account*.json

# docs and local noise
*.md
guide/
.vscode/
.idea/
.DS_Store
